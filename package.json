{
  "name": "@rheactor/rheactor-pg-query-builder",
  "version": "1.0.0",
  "description": "Rheactor PostgreSQL Query Builder.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "bun run lint && tsdown",
    "lint": "bun run typecheck && bun run oxlint && bun run oxfmt",
    "lint:fix": "bun run typecheck && bun run oxlint:fix && bun run oxfmt:fix",
    "oxfmt": "oxfmt --check ./src ./tests ./*.json",
    "oxfmt:fix": "oxfmt --write ./src ./tests ./*.json",
    "oxlint": "oxlint ./src ./tests",
    "oxlint:fix": "oxlint --fix ./src ./tests",
    "test": "vitest --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rheactor/rheactor-oxc-config": "github:rheactor/rheactor-oxc-config",
    "@rheactor/rheactor-pg-connector": "github:rheactor/rheactor-pg-connector",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
