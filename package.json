{
  "name": "@rheactor/rheactor-pg-query-builder",
  "version": "1.0.0",
  "description": "Rheactor Query Builder for PostgreSQL.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts",
    "#tests/*": "./tests/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "lint": "bun run typecheck && bun run eslint && bun run oxfmt",
    "lint:fix": "bun run typecheck && bun run eslint:fix && bun run oxfmt:fix",
    "typecheck": "tsc --noEmit",
    "oxfmt": "oxfmt --check ./src ./tests ./*.mjs ./*.json",
    "oxfmt:fix": "oxfmt --write ./src ./tests ./*.mjs ./*.json",
    "eslint": "eslint ./src ./tests ./*.mjs",
    "eslint:fix": "eslint --fix ./src ./tests ./*.mjs",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@rheactor/eslint-config-rheactor": "github:rheactor/eslint-config-rheactor",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "^1.6.24",
    "eslint": "^10.7.0",
    "oxfmt": "^0.60.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
